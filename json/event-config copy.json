          "street": {
            "type": "text",
            "label": "Rue"
          },
          "number": {
            "type": "text",
            "label": "Numéro"
          },
          "postcode": {
            "type": "text",
            "label": "Code Postal"
          },
          "city": {
            "type": "text",
            "label": "Ville"
          },
          "country": {
            "type": "text",
            "label": "Pays"
          }
        },
        "order": 4
      }
    ,
      "description_event": {
        "type": "object",
        "label": "Description",
        "structure": {
          "fr": {
            "type": "text",
            "label": "Description en français"
          },
          "en": {
            "type": "text",
            "label": "Description in English"
          },
          "nl": {
