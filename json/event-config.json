{
  "event": {
    "id": {
      "type": "text",
      "label": "ID de l'événement",
      "readonly": true,
      "order": 1
    },
    "title": {
      "type": "text",
      "label": "Titre de l'événement",
      "required": true,
      "order": 2
    },
    "date": {
      "type": "date",
      "label": "Date",
      "required": true,
      "order": 3
    },
    "location": {
      "type": "text",
      "label": "Lieu",
      "order": 4
    },
    "description_event": {
      "type": "object",
      "label": "Description",
      "structure": {
        "fr": {
          "type": "text",
          "label": "Description en français"
        },
        "en": {
          "type": "text",
          "label": "Description in English"
        },
        "nl": {
          "type": "text",
          "label": "Beschrijving in het Nederlands"
        }
      },
      "order": 5
    },
    "illustration": {
      "type": "text",
      "label": "Illustration",
      "readonly": true,
      "order": 6
    },
    "activity_type_ids": {
      "type": "checkboxes",
      "label": "Types d'activités",
      "source": "../json/activity-types.json",
      "structure": {
        "id": "id",
        "label": "fr"
      }
    },
    "artists": {
      "type": "checkboxes",
      "label": "Artistes",
      "source": "api/artists-list.php",
      "structure": {
        "id": "id",
        "label": "name"
      },
      "order": 8
    },
    "infospratiques": {
      "type": "object",
      "label": "Informations Pratiques",
      "structure": {
        "organisation": {
          "type": "text",
          "label": "Organisation"
        },
        "necessitedbook": {
          "type": "checkbox",
          "label": "Nécessite une réservation"
        },
        "price": {
          "type": "text",
          "label": "Prix"
        },
        "situation": {
          "type": "object",
          "label": "Adresse",
          "structure": {
            "street": {
              "type": "text",
              "label": "Rue"
            },
            "number": {
              "type": "text",
              "label": "Numéro"
            },
            "postcode": {
              "type": "text",
              "label": "Code Postal"
            },
            "city": {
              "type": "text",
              "label": "Ville"
            },
            "country": {
              "type": "text",
              "label": "Pays"
            }
          }
        }
      },
      "order": 9
    },
    "ticket": {
      "type": "object",
      "label": "Billetterie",
      "structure": {
        "link": {
          "type": "text",
          "label": "Lien pour les billets",
          "validation": "url",
          "errorMessage": "URL invalide"
        }
      },
      "order": 10
    },
    "links": {
      "type": "array",
      "label": "Liens",
      "structure": {
        "name": {
          "type": "text",
          "label": "Nom du lien"
        },
        "url": {
          "type": "text",
          "label": "URL",
          "validation": "url",
          "errorMessage": "URL invalide"
        }
      },
      "order": 11
    }
  }
}